{
  "name": "audioforge",
  "version": "0.1.0",
  "private": true,
  "description": "Script → Episode Engine. Upload a script → get a production-ready multi-character audio episode.",
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "spike": "tsx scripts/spike/generate.ts",
    "parse": "tsx scripts/parse.ts",
    "voices": "tsx scripts/assign-voices.ts",
    "generate": "tsx scripts/generate-episode.ts",
    "sfx:init": "tsx scripts/generate-sfx.ts",
    "mix": "tsx scripts/mix-episode.ts",
    "benchmark": "tsx scripts/benchmark.ts",
    "test": "node --test scripts/bundle-budget.test.mjs",
    "perf:budget": "node scripts/check-bundle-budget.mjs",
    "postbuild": "node scripts/check-bundle-budget.mjs",
    "test:parser": "tsx scripts/test-parser.ts",
    "db:sync": "tsx scripts/sync-prisma.ts",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "check:colors": "house-check-raw-color app lib server scripts"
  },
  "dependencies": {
    "@house/react": "file:vendor/house-react-0.1.0.tgz",
    "@house/tokens": "file:vendor/house-tokens-0.1.1.tgz",
    "@prisma/client": "^6.16.1",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "next": "^15.5.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "sarvamai": "^1.1.8-alpha.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.1",
    "@tailwindcss/postcss": "^4.1.13",
    "@types/node": "^22.18.6",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "eslint": "^9.36.0",
    "eslint-config-next": "^15.5.4",
    "prisma": "^6.16.1",
    "tailwindcss": "^4.1.13",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
