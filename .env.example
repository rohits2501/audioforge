# Required for real Sarvam TTS. Without it, the pipeline falls back to
# macOS `say` (offline) so parse → mix → review still works.
SARVAM_API_KEY=

# Optional. Week-4 quality/cost benchmark only. TTS — never Music.
ELEVENLABS_API_KEY=

# Prisma (SQLite locally; swap the provider to postgresql when you add Postgres)
DATABASE_URL="file:./data/dev.db"
